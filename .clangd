CompileFlags:
  CompilationDatabase: build/build/Release

# Use LLVM Clang for C++20 modules support
# clangd should pick up the right compiler from compile_commands.json

Diagnostics:
  UnusedIncludes: None
  ClangTidy:
    Remove: ['*']  # Disable clang-tidy in LSP; run manually post-build

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
